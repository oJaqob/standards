{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "noGlobalEval": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noEmptyPattern": "off",
        "noInnerDeclarations": "off"
      },
      "style": {
        "useConst": "error",
        "noProcessEnv": "error",
        "useImportType": "error",
        "noNonNullAssertion": "error",
        "noNamespace": "off",
        "useConsistentObjectDefinitions": "error"
      },
      "suspicious": {
        "noDeprecatedImports": "error",
        "noMisleadingCharacterClass": "off",
        "useAwait": "error",
        "noEmptyBlockStatements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/vitest.setup.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "useAwait": "off",
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
